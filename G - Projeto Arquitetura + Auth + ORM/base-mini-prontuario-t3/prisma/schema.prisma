generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model encounters {
  id                  Int                   @id @default(autoincrement())
  patient_id          Int
  started_at          String
  chief_complaint     String
  notes               String?
  patients            patients              @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  medication_requests medication_requests[]

  @@index([patient_id], map: "idx_encounters_patient")
}

model medication_requests {
  id           Int        @id @default(autoincrement())
  encounter_id Int
  medication   String
  dosage       String
  encounters   encounters @relation(fields: [encounter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([encounter_id], map: "idx_medreq_encounter")
}

model patients {
  id          Int          @id @default(autoincrement())
  name        String
  birth_date  String
  national_id String       @unique(map: "sqlite_autoindex_patients_1")
  photo_url   String?
  active      Int          @default(1)
  encounters  encounters[]
}
