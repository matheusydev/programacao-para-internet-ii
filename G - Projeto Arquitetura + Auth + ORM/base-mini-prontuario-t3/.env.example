# Copie para .env (que NUNCA e commitado — invariante OP-2) e preencha.
# Gere um segredo forte:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-este-valor
JWT_EXPIRES_IN=15m

# Usado pelo Prisma a partir da trilha ORM (SQLite local).
# O caminho é relativo ao prisma/schema.prisma, por isso começa com "../".
DATABASE_URL="file:../database/prontuario.db"
